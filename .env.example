SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# AI adapter (src/lib/ai/provider.ts)
# One of: lovable | gemini | openai | openrouter
AI_PROVIDER=
# Defaults to google/gemini-3.6-flash when unset. For openrouter, use its
# provider/model slug form, e.g. google/gemini-3.6-flash
AI_MODEL=
# Fast/cheap model for Cascade pattern (defaults to google/gemini-2.5-flash)
AI_CHEAP_MODEL=
LOVABLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter cost controls: automatically use :floor suffix for lowest price provider (default true)
OPENROUTER_USE_FLOOR=true
# Jev System One pre-gate for AI shortlist and resume parsing (src/lib/ai/provider.ts decide()).
# Off unless JEV_ENABLED=true. Requires OPENROUTER_API_KEY. Default model
# is ~typesafe/jev-latest when JEV_MODEL is unset.
JEV_ENABLED=
JEV_MODEL=

# In-app video interviews (src/lib/zoom/, src/lib/interview.functions.ts)
# Server-to-Server OAuth app (scopes: meeting:write:admin, meeting:read:admin,
# meeting:update:admin, meeting:delete:admin, user:read:token:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The single platform host account meetings are created under (v1: one host)
ZOOM_HOST_USER_ID=
# Signs/verifies the T-30 reminder email's magic join link (any long random string).
# Must be set as the SAME value on the Supabase Edge Function secrets
# (Dashboard → Edge Functions → Secrets). Email 1 (scheduled) does not need
# this; Email 2 (join link at T-30) 500s without it. Also set PUBLIC_APP_URL
# on the Edge Function so the join button is not localhost.
INTERVIEW_HMAC_SECRET=



# Payments (src/lib/razorpay.server.ts, src/routes/api/public/webhooks/razorpay.ts)
# Test keys start with rzp_test_. Webhook secret must match Razorpay Dashboard -> Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp (Meta Cloud API) — src/lib/whatsapp.server.ts, supabase/functions/_shared/whatsapp.ts,
# src/routes/api/public/webhooks/whatsapp.ts. See whatsapp-centric-ux-implementation-improved.md
# for the full design. Everything in this repo already works with these unset — sends are
# skipped with a logged "not configured" error, same as RESEND_API_KEY missing — so dropping in
# real values later needs no code change.
# 1. Create/select a WhatsApp Business app in Meta Business Manager, get a permanent
#    system-user access token for it (not the 24h test token).
WHATSAPP_ACCESS_TOKEN=
# 2. The sending number's phone_number_id from the same app (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# 3. App Settings -> Basic -> App Secret. Used to verify the x-hub-signature-256 header
#    on every inbound webhook call before any data is touched.
WHATSAPP_APP_SECRET=
# 4. Any string you choose yourself — enter the SAME value when configuring the webhook
#    in Meta (App -> WhatsApp -> Configuration -> Webhook -> Verify token). Used only for
#    the one-time GET handshake.
WHATSAPP_VERIFY_TOKEN=
# Webhook callback URL to register in Meta: https://<your-domain>/api/public/webhooks/whatsapp
# These four must ALSO be set as Supabase secrets (`supabase secrets set WHATSAPP_ACCESS_TOKEN=...`
# etc.) for the edge functions in supabase/functions/ to see them — this .env only covers the
# TanStack Start server (the webhook route and src/lib/whatsapp.server.ts).
