SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# AI adapter (src/lib/ai/provider.ts)
# One of: lovable | gemini | openai | openrouter
AI_PROVIDER=
# Defaults to google/gemini-3.6-flash when unset. For openrouter, use its
# provider/model slug form, e.g. google/gemini-3.6-flash
AI_MODEL=
LOVABLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Jev System One pre-gate for AI shortlist (src/lib/ai/provider.ts decide()).
# Off unless JEV_ENABLED=true. Requires OPENROUTER_API_KEY. Default model
# is ~typesafe/jev-latest when JEV_MODEL is unset.
JEV_ENABLED=
JEV_MODEL=

# In-app video interviews (src/lib/zoom/, src/lib/interview.functions.ts)
# Server-to-Server OAuth app (scopes: meeting:write:admin, meeting:read:admin,
# meeting:update:admin, meeting:delete:admin, user:read:token:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The single platform host account meetings are created under (v1: one host)
ZOOM_HOST_USER_ID=
# Signs/verifies the T-30 reminder email's magic join link (any long random string).
# Must be set as the SAME value on the Supabase Edge Function secrets
# (Dashboard → Edge Functions → Secrets). Email 1 (scheduled) does not need
# this; Email 2 (join link at T-30) 500s without it. Also set PUBLIC_APP_URL
# on the Edge Function so the join button is not localhost.
INTERVIEW_HMAC_SECRET=


